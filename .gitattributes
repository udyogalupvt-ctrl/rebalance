# Normalise line endings so the working tree matches the index on every OS.
# Without this, core.autocrlf=true checks files out as CRLF on Windows while
# they are stored as LF, and prettier flags every line in the repo.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
